{
  "base_url": "https://www.quantbuddy.cn/skill",
  "_comment_api_key": "在 config.local.json 里填 api_key，不要提交到 git",
  "skill_version": "4.21.1",
  "skill_channel": "github",
  "check": {
    "_comment": "timeout_sec=单个端点超时秒数",
    "timeout_sec": 60,
    "endpoints": [
      {
        "name": "fastQuery",
        "method": "POST",
        "path": "/fastQuery",
        "payload": {"assets": ["贵州茅台"], "query_type": "snapshot", "fields": ["收盘价"]},
        "critical": true,
        "desc": "核心数据查询通道"
      },
      {
        "name": "fastQuery行情、估值、财务探测",
        "method": "POST",
        "path": "/fastQuery",
        "payload": {
          "assets": ["GC.CMX"],
          "query_type": "window",
          "fields": ["收盘价"],
          "start_date": "由检查程序动态设置为当年1月1日",
          "end_date": "由检查程序动态设置为当天",
          "user_query": "test"
        },
        "current_year_date_range": true,
        "expect_fields": {"data.success": true},
        "capture_full_response": true,
        "desc": "行情、估值、财务探测；data.success=false 时失败并记录完整响应"
      },
      {
        "name": "searchFunctions",
        "method": "POST",
        "path": "/searchFunctions",
        "payload": {"query": "回测", "top_k": 1},
        "desc": "函数检索"
      },
      {
        "name": "searchSimilarCases",
        "method": "POST",
        "path": "/searchSimilarCases",
        "payload": {"query": "收盘价排名"},
        "desc": "案例模板搜索"
      },
      {
        "name": "confirmDataMulti",
        "method": "POST",
        "path": "/confirmDataMulti",
        "payload": {"data_desc": "全市场每日收盘价"},
        "desc": "数据确认"
      },
      {
        "name": "stockProfile",
        "method": "POST",
        "path": "/stockProfile",
        "payload": {"asset": "贵州茅台", "task_id": "health-check-probe"},
        "desc": "个股指标画像"
      },
      {
        "name": "version/check",
        "method": "GET",
        "path": "/skill/version/check",
        "payload": null,
        "desc": "控制面版本检查"
      },
      {
        "name": "runMultiFormulaBatchStream",
        "method": "POST",
        "path": "/runMultiFormulaBatchStream",
        "payload": {
          "task_id": "api-health-check-run-multi-formula-stream",
          "formulas": [
            "均线条件 = \"全市场每日收盘价\" > 平均(\"全市场每日收盘价\", 5)"
          ]
        },
        "stream": true,
        "unique_task_id": true,
        "follow_stream_url": true,
        "timeout": 60,
        "expect_fields": {"status": "success"},
        "require_non_empty_fields": ["index_info.description"],
        "desc": "批量公式流式计算"
      }
    ]
  },
  "email": {
    "_comment": "163 邮箱 SMTP；sender_email 和 smtp_password(授权码) 填 config.local.json",
    "smtp_server": "smtp.163.com",
    "smtp_port": 465,
    "use_ssl": true,
    "subject_prefix": "[API健康检查]",
    "recipient_emails": []
  },
  "voice_call": {
    "_comment": "阿里云语音告警；access_key_id/secret 和 tts_code 填 config.local.json",
    "enabled": true,
    "endpoint": "dyvmsapi.aliyuncs.com",
    "called_number": "17854119861",
    "called_show_number": "",
    "tts_code": ""
  },
  "report": {
    "announce_max_chars": 2000
  }
}
